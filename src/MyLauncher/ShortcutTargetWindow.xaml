<!-- 【WPF標準】登録コピーのリンク先を編集するダイアログ。 -->
<Window x:Class="MyLauncher.ShortcutTargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FocusManager.FocusedElement="{Binding ElementName=TargetInput}">
    <!-- 【WPF標準】リンク先の入力欄と検証結果を縦に並べる。 -->
    <StackPanel Margin="24">
        <Label x:Name="TargetLabel" Target="{Binding ElementName=TargetInput}" Padding="0,0,0,6" />
        <TextBox x:Name="TargetInput" Padding="6" />
        <TextBlock x:Name="ValidationMessage" Margin="0,8,0,0" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />

        <!-- 【WPF標準】Enter で保存、Esc でキャンセルできるようにする。 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保存" IsDefault="True" Click="OnSaveClick" MinWidth="80" Padding="12,5" />
            <Button Content="キャンセル" IsCancel="True" MinWidth="80" Margin="8,0,0,0" Padding="12,5" />
        </StackPanel>
    </StackPanel>
</Window>
