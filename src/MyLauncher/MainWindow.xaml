<!-- ランチャーのメインウィンドウを定義する。 -->
<Window
    x:Class="MyLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="My Launcher"
    Height="800"
    Width="1200"
    AllowDrop="True"
    Drop="OnDrop">

    <!-- 一覧項目で使う右クリックメニューを定義する。 -->
    <Window.Resources>
        <ContextMenu x:Key="ShortcutContextMenu" Opened="OnShortcutMenuOpened">
            <!-- メニューを開いたときに、選択件数で有効・無効を切り替える。 -->
            <MenuItem Header="Rename" Tag="Rename" IsEnabled="False" Click="OnRenameShortcut" />
            <MenuItem Header="Delete" Click="OnDeleteShortcuts" />
        </ContextMenu>
    </Window.Resources>

    <!-- 左にリスト、右にメイン画面を配置する。 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="7*" />
        </Grid.ColumnDefinitions>

        <!-- 一覧にショートカット名を表示し、複数選択を有効にする。 -->
        <ListBox Grid.Column="0"
                 x:Name="ShortcutList"
                 DisplayMemberPath="Name"
                 SelectionMode="Extended">
            <ListBox.ItemContainerStyle>
                <!-- 各項目にダブルクリックと右クリックメニューを設定する。 -->
                <Style TargetType="ListBoxItem">
                    <EventSetter Event="MouseDoubleClick"
                                 Handler="OnShortcutDoubleClick" />
                    <Setter Property="ContextMenu"
                            Value="{StaticResource ShortcutContextMenu}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- 右側をメイン画面として使う。 -->
        <Grid Grid.Column="1" Background="Transparent" />
    </Grid>
</Window>