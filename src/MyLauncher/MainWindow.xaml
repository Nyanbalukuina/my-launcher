<!-- 【WPF標準】Window の DragOver と Drop を【自作】のイベント処理に結び付ける。 -->
<Window x:Class="MyLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyLauncher"
        Title="My Launcher" 
        Height="900" 
        Width="1200"
        AllowDrop="True" 
        DragOver="OnDragOver" 
        Drop="OnDrop"
>
    <!-- 【WPF標準】右クリックした項目をメニューへ渡し、Click を【自作】の処理に結び付ける。 -->
    <Window.Resources>
        <ContextMenu x:Key="ShortcutContextMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="削除" Click="OnDeleteShortcutClick" />
            <MenuItem Header="パスを変更" Click="OnChangeTargetClick" />
        </ContextMenu>
    </Window.Resources>
    <!-- 【WPF標準】透明な Grid で余白にもドロップできるようにする。 -->
    <Grid Background="Transparent">
        <!-- 【WPF標準】DockPanel で案内を上部に、一覧を残りの領域に置く。 -->
        <DockPanel Margin="24">
            <!-- 【WPF標準】StackPanel にドロップの案内と結果を縦に並べる。 -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock
                    Text="ショートカット（.lnk、.url）をドロップして登録、ダブルクリックで起動"
                    FontSize="20" 
                    TextAlignment="Center" 
                    TextWrapping="Wrap"
                />
                <TextBlock 
                    x:Name="ShortcutStatus" 
                    Margin="0,12,0,0"
                    TextAlignment="Center" 
                    TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite" 
                />
            </StackPanel>
            <!-- 【WPF標準】ListBox の入力イベントを【自作】の起動処理に結び付ける。 -->
            <ListBox 
                x:Name="ShortcutList" 
                HorizontalContentAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                PreviewMouseDown="OnShortcutMouseDown" 
                PreviewKeyDown="OnShortcutKeyDown"
                AutomationProperties.Name="登録済みショートカット"
            >
                <!-- 【WPF標準】WrapPanel でアイコンを横に並べ、幅に合わせて折り返す。 -->
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <!-- 【WPF標準】アイコンを非同期で取得し、下にショートカット名を表示する。 -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Image Width="40" Height="40"
                                   Source="{Binding Icon, IsAsync=True, FallbackValue={x:Static local:ShortcutIcon.Default}}" />
                            <TextBlock Text="{Binding DisplayName}" Margin="0,6,0,0"
                                       TextAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <!-- 【WPF標準】アイコンと名前をクリックや右クリックができる一つの項目として扱う。 -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="112" />
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Padding" Value="8" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="ToolTip" Value="{Binding DisplayName}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                        <Setter Property="ContextMenu" Value="{StaticResource ShortcutContextMenu}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
